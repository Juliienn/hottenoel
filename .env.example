# Base Postgres (Neon en production). URL "pooled" pour l'application…
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"
# …et URL directe (sans "-pooler") pour les migrations.
DIRECT_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"
# Jeton secret pour créer le compte Hôte sur /installation (au moins 16 caractères).
# Une fois l'Hôte créé, la page /installation est définitivement fermée.
SETUP_TOKEN="remplace-moi-par-une-longue-phrase-secrete"

# ---- Envoi automatique des SMS (facultatif) ----
# Sans ces variables, le bouton SMS de l'Espace Hôte ouvre l'application
# Messages du téléphone (message prérempli) ou permet de copier le texte.
# Avec un fournisseur configuré, un bouton « Envoyer via … » expédie le SMS
# depuis le serveur, y compris depuis un ordinateur.
# SMS_PROVIDER="twilio"            # ou "brevo" ; facultatif s'il n'y en a qu'un
# Twilio :
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+33XXXXXXXXX"        # numéro Twilio, ou bien :
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxx"
# Brevo :
# BREVO_API_KEY="xkeysib-..."
# BREVO_SMS_SENDER="HotteNoel"      # 11 caractères alphanumériques max
